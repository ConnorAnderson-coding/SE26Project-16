# 复制为 .env 后按需修改。不要把含真实密钥的 .env 提交到 Git。

# 对外访问入口（Nginx）
HTTP_PORT=80
PUBLIC_BASE_URL=http://localhost

# 本机环回排障端口（不对公网）
MYSQL_PORT=3307
REDIS_PORT=6379
ES_HTTP_PORT=9200
CLUSTERING_PORT=8000

MYSQL_USER=campus
MYSQL_PASSWORD=campus123
MYSQL_ROOT_PASSWORD=root123

# 生产务必更换
JWT_SECRET=campus-activity-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm

# 云服务器上若尚未配置 JAccount，保持 false
JACCOUNT_ENABLED=false
JACCOUNT_CLIENT_SECRET=

CORS_ORIGINS=http://localhost,http://127.0.0.1

ES_ENABLED=true
ES_AUTO_REBUILD=true
ES_JAVA_OPTS=-Xms2g -Xmx2g

COMMUNITY_CLUSTERING_ENABLED=true

# 100 并发压测相关
TOMCAT_MAX_THREADS=200
TOMCAT_ACCEPT_COUNT=200
HIKARI_MAX_POOL=50
HIKARI_MIN_IDLE=10
BACKEND_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# 国内构建镜像加速（可改阿里云 / 清华）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
